RETELL_API_KEY=
RETELL_AGENT_ID=
RETELL_KNOWLEDGE_BASE_ID=
# Default voice when provisioning a new organization (Retell voice_id)
RETELL_DEFAULT_VOICE_ID=custom_voice_c9dc5cf570a94a9201c339dec5
PORT=8787

SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres (migrations only — do not commit password)
# Required for local SQL migrations (npm run db:migrate:eval). Supabase → Database → Connection string (Transaction pooler).
# DATABASE_URL=postgresql://postgres.oenzdaxoskukgzxaewdq:[YOUR_DB_PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres

# Phase 1 organization (optional until migration is applied)
VOCA_ORG_SLUG=bahria-khi
VOCA_BOOTSTRAP_SUPER_ADMIN_EMAIL=
VOCA_BOOTSTRAP_SUPER_ADMIN_NAME=Super Admin

# Auth / invites
# Invite/recovery redirect target. Local: http://localhost:5173
# Production (set on Vercel): https://fyp-bahria-university-admin.vercel.app
# If unset on Vercel, VERCEL_URL is used automatically.
VOCA_APP_URL=http://localhost:5173
VOCA_INVITE_DELIVERY=copy_only
RESEND_API_KEY=
RESEND_FROM=VOCA <onboarding@resend.dev>
VOCA_ALLOWED_EMAIL_DOMAIN=

# One-time platform (omega) admin bootstrap — POST /api/platform/bootstrap with header x-platform-bootstrap-secret
VOCA_PLATFORM_BOOTSTRAP_SECRET=
# Platform usage cost estimate on omega dashboard (USD per minute)
VOCA_PLATFORM_COST_PER_MINUTE=0.3
