    "org:smoke": "node scripts/phase1-org-smoke.mjs",
    "db:migrate:eval": "node scripts/apply-migration.mjs supabase/migrations/20261115210000_evaluation_likert_flags.sql",
    "agent:smoke": "node scripts/agent-prompt-smoke.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
